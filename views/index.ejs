<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Caveat&family=Cinzel&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Cinzel&family=Tangerine&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Cinzel&family=Great+Vibes&display=swap" rel="stylesheet">
  <title>Index</title>
  <link rel="stylesheet" href="/main.css"> </head>
<body>
    <%- include("partials/header.ejs") %>

    <div class="main-content-wrapper"> <div class="main">
            <div class="welcome">
                <h1>DAILY <span class="insights">INSIGHTS</span></h1>
                <p id="para">Unlock the power of your daily journey. DAILY INSIGHTS offers a serene, intuitive space to capture your thoughts and document your personal growth. Cultivate clarity, preserve cherished memories, and rediscover your story, one mindful entry at a time.</p>
                <div id="createpost">
                    <a href="/create">Create Post</a>
                </div>
            </div>

            <div class="list">
                <ul>
                    <% posts.forEach((post)=>{%>
                        <li class="post-item">
                            <div class="post-info">
                                <a href="/posts/<%= post._id %>" class="post-title-link"><%= post.title %></a>
                                <% if (post.createdAt) { %>
                                    <p class="post-date">
                                        Posted on: <%= post.createdAt.toLocaleDateString('en-US', {
                                            year: 'numeric',
                                            month: 'long',
                                            day: 'numeric'
                                        }) %>
                                    </p>
                                <% } %>
                            </div>
                            <div class="post-actions">
                                <a href="/posts/<%= post._id %>/edit">Edit</a>
                                <form action="/posts/<%= post._id %>/delete" method="POST" style="display:inline;">
                                    <button type="submit" onclick="return confirm('Are you sure you want to delete this post?');">Delete</button>
                                </form>
                            </div>
                        </li>
                    <%})%>
                </ul>
            </div>
        </div>
    </div>

    <div class="footer-wrapper"> <%- include("partials/footer.ejs") %>
    </div>
</body>
</html>